# ---------------------------------------------------------------- autenticação
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

MAX_AUTH_ATTEMPTS=3
# Por quanto tempo um CPF fica bloqueado depois de esgotar as tentativas.
AUTH_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- banco de dados
# SQLite local; em produção use postgresql+asyncpg://user:senha@host/base
DATABASE_URL=sqlite+aiosqlite:///./data/banco_agil.db
# Recria o banco a partir dos CSVs a cada boot. Verdadeiro na demo, falso em produção.
DEMO_RESET_ON_START=true
# CSVs usados como fonte do seed.
DATA_DIR=src/data

# ---------------------------------------------------------------- demonstração
# Liga as personas de demonstração e o auto-cadastro público.
DEMO_MODE=true
DEMO_PERSONA_COUNT=4
SIGNUP_ENABLED=true
SIGNUP_INITIAL_SCORE=500
SIGNUP_MIN_AGE_YEARS=18

# ---------------------------------------------------------------- integrações
# Verificação de CPF: "mock" (offline, só dígitos verificadores) ou "serpro".
# Não existe API pública e gratuita de consulta de CPF no Brasil; o adaptador Serpro
# está implementado e só precisa do token para entrar no lugar do mock.
CPF_PROVIDER=mock
SERPRO_API_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v1
SERPRO_API_TOKEN=

# Consulta de CEP (BrasilAPI: pública, gratuita, sem chave).
ADDRESS_API_URL=https://brasilapi.com.br/api/cep/v2

EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest
EXCHANGE_API_KEY=

# ---------------------------------------------------------------- LLM
USE_LANGCHAIN=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---------------------------------------------------------------- limites e abuso
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SIGNUP=5/minute
MAX_MESSAGE_LENGTH=2000
SESSION_TTL_MINUTES=30

# ---------------------------------------------------------------- observabilidade
LOG_LEVEL=INFO
# JSON em uma linha por evento, filtrável por request_id. Ligue em produção.
JSON_LOGS=false
# Domínios do front separados por vírgula; "*" só enquanto a API é pública e sem cookie.
CORS_ORIGINS=*
