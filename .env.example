JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

# Set to true to enable LLM-backed humanization + intent fallback.
USE_LANGCHAIN=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=160
LLM_TIMEOUT_SECONDS=8

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest
EXCHANGE_API_KEY=
EXCHANGE_CACHE_TTL_SECONDS=300

LOG_LEVEL=INFO
DATA_DIR=src/data
MAX_AUTH_ATTEMPTS=3

# Comma-separated list when set via env (FastAPI receives as list)
CORS_ORIGINS=["*"]
